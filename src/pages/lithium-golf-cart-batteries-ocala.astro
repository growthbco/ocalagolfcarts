---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Lithium Golf Cart Batteries Ocala | Bolt Energy Dealer | $400 Off Memorial Day"
  description="Authorized Bolt Energy lithium golf cart battery dealer serving Ocala, Belleview, The Villages & surrounding areas. EZGO, Club Car & Yamaha conversions. $400 off Memorial Day special. 12-year warranty. Call (352) 780-1526."
>
  <!-- Memorial Day Promo Banner -->
  <section class="bg-gradient-to-r from-amber-500 via-red-500 to-blue-600 text-white py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-base sm:text-lg font-semibold flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4">
        <span class="inline-flex items-center"><i class="fa-solid fa-flag-usa mr-2"></i> MEMORIAL DAY SPECIAL</span>
        <span class="hidden sm:inline">•</span>
        <span>$400 OFF Bolt Energy Lithium Conversion</span>
        <span class="hidden sm:inline">•</span>
        <span class="bg-white text-red-600 px-3 py-1 rounded-full text-sm font-bold tracking-wider">CODE: MEMORIAL400</span>
      </p>
    </div>
  </section>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-emerald-600 to-emerald-800 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-white/15 backdrop-blur-sm text-white px-4 py-2 rounded-full text-sm font-semibold mb-6 border border-white/20">
        <i class="fa-solid fa-bolt mr-2"></i> Authorized Bolt Energy Dealer
      </span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
        Lithium Golf Cart Batteries<br>
        <span class="text-emerald-200">in Ocala &amp; Belleview, FL</span>
      </h1>
      <p class="text-xl text-emerald-100 max-w-3xl mx-auto mb-10 leading-relaxed">
        Upgrade your EZGO, Club Car, Yamaha or any 36V/48V/72V golf cart with premium Bolt Energy lithium batteries. Up to 70-mile range, 12-year warranty, zero maintenance. Serving golf cart owners within 25 miles of Belleview.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="tel:+13527801526" class="bg-white text-emerald-700 px-10 py-4 rounded-full text-lg font-semibold hover:bg-emerald-50 transform hover:scale-105 transition-all duration-300 shadow-lg">
          <i class="fa-solid fa-phone mr-2"></i> Call (352) 780-1526
        </a>
        <a href="#memorial-day-offer" class="border-2 border-white text-white px-10 py-4 rounded-full text-lg font-semibold hover:bg-white hover:text-emerald-700 transform hover:scale-105 transition-all duration-300">
          <i class="fa-solid fa-tag mr-2"></i> Claim $400 Off
        </a>
      </div>
    </div>
  </section>

  <!-- Memorial Day Offer Card -->
  <section id="memorial-day-offer" class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-emerald-50 to-white border-2 border-emerald-200 rounded-3xl p-8 sm:p-12 shadow-2xl text-center relative overflow-hidden">
        <div class="absolute top-6 right-6 bg-red-500 text-white px-4 py-2 rounded-full text-xs font-bold tracking-wider transform rotate-6">LIMITED TIME</div>
        <span class="inline-block bg-emerald-100 text-emerald-800 px-4 py-2 rounded-full text-sm font-semibold mb-4">Memorial Day Special</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-emerald-900 mb-4">$400 OFF</h2>
        <p class="text-xl text-emerald-800 font-semibold mb-2">Your Bolt Energy Lithium Battery Conversion</p>
        <p class="text-neutral-600 mb-8">Valid through Memorial Day 2026 — Mention code <strong class="text-emerald-700">MEMORIAL400</strong> when you call.</p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8 max-w-2xl mx-auto text-sm">
          <div class="bg-white border border-emerald-100 rounded-xl p-4">
            <i class="fa-solid fa-calendar-day text-emerald-600 text-2xl mb-2"></i>
            <p class="font-semibold text-emerald-900">Offer Ends</p>
            <p class="text-neutral-600">May 26, 2026</p>
          </div>
          <div class="bg-white border border-emerald-100 rounded-xl p-4">
            <i class="fa-solid fa-shield-halved text-emerald-600 text-2xl mb-2"></i>
            <p class="font-semibold text-emerald-900">12-Year Warranty</p>
            <p class="text-neutral-600">Transferable coverage</p>
          </div>
          <div class="bg-white border border-emerald-100 rounded-xl p-4">
            <i class="fa-solid fa-truck text-emerald-600 text-2xl mb-2"></i>
            <p class="font-semibold text-emerald-900">Free Local Install</p>
            <p class="text-neutral-600">25-mile service radius</p>
          </div>
        </div>

        <a href="tel:+13527801526" class="bg-gradient-to-r from-emerald-600 to-emerald-700 text-white px-10 py-4 rounded-full text-lg font-semibold hover:from-emerald-700 hover:to-emerald-800 transform hover:scale-105 transition-all duration-300 shadow-lg inline-block">
          <i class="fa-solid fa-phone mr-2"></i> Call to Lock In $400 Off
        </a>
      </div>
    </div>
  </section>

  <!-- Why Lithium -->
  <section class="py-16 sm:py-20 bg-gradient-to-br from-emerald-50 to-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-16">
        <span class="inline-block bg-emerald-100 text-emerald-800 px-4 py-2 rounded-full text-sm font-semibold mb-4">Why Switch</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-emerald-900 mb-6">Lithium vs. Lead-Acid — No Contest</h2>
        <p class="text-lg sm:text-xl text-neutral-600 max-w-2xl mx-auto px-4">Bolt Energy lithium batteries outperform old-school lead-acid in every category that matters</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white rounded-2xl p-8 shadow-lg border border-emerald-100">
          <div class="w-16 h-16 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg">
            <i class="fa-solid fa-road text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-emerald-900 mb-4">Up to 70-Mile Range</h3>
          <p class="text-neutral-600">Cruise from Belleview to Ocala and back on a single charge. The 51.2V 160AH and 73.6V 105AH models deliver 70 miles on a full tank.</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-lg border border-emerald-100">
          <div class="w-16 h-16 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg">
            <i class="fa-solid fa-shield-halved text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-emerald-900 mb-4">12-Year Warranty</h3>
          <p class="text-neutral-600">Industry-leading 12-year transferable warranty. Sell your cart with confidence — the battery coverage transfers to the new owner.</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-lg border border-emerald-100">
          <div class="w-16 h-16 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg">
            <i class="fa-solid fa-wrench text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-emerald-900 mb-4">Zero Maintenance</h3>
          <p class="text-neutral-600">No watering, no acid, no corrosion. Automatic storage mode keeps your pack healthy when the cart sits.</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-lg border border-emerald-100">
          <div class="w-16 h-16 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg">
            <i class="fa-solid fa-bolt-lightning text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-emerald-900 mb-4">Faster Charging</h3>
          <p class="text-neutral-600">Recharge in a fraction of the time lead-acid takes. Plug in overnight, head out at dawn — no babysitting required.</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-lg border border-emerald-100">
          <div class="w-16 h-16 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg">
            <i class="fa-solid fa-feather text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-emerald-900 mb-4">Up to 70% Lighter</h3>
          <p class="text-neutral-600">Lithium packs weigh a fraction of lead-acid sets. Better acceleration, longer brake life, easier on the chassis.</p>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-lg border border-emerald-100">
          <div class="w-16 h-16 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center mb-6 shadow-lg">
            <i class="fa-solid fa-layer-group text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-emerald-900 mb-4">Multi-Layer Protection</h3>
          <p class="text-neutral-600">Built-in BMS, thermal protection, and multiple safety layers. Bolt Energy is part of the Nivel family — the industry's most trusted name.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Battery Lineup -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-16">
        <span class="inline-block bg-emerald-100 text-emerald-800 px-4 py-2 rounded-full text-sm font-semibold mb-4">The Lineup</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-emerald-900 mb-6">Bolt Energy Battery Models</h2>
        <p class="text-lg sm:text-xl text-neutral-600 max-w-2xl mx-auto px-4">Six purpose-built lithium packs — 36V, 48V, and 72V options with heated and non-heated configurations</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-6 shadow-lg border border-emerald-100 hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
          <div class="flex items-baseline justify-between mb-3">
            <h3 class="text-2xl font-bold text-emerald-900">38.4V 105AH</h3>
            <span class="text-xs text-neutral-500 font-mono">33-102</span>
          </div>
          <p class="text-sm text-emerald-700 font-semibold mb-3">Fits 36V Golf Carts</p>
          <p class="text-3xl font-bold text-emerald-600 mb-4">30 mi <span class="text-sm font-normal text-neutral-500">range</span></p>
          <p class="text-sm text-neutral-600">Perfect for older 36V EZGO and Club Car platforms — modern lithium performance in a classic chassis.</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-lg border border-emerald-100 hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
          <div class="flex items-baseline justify-between mb-3">
            <h3 class="text-2xl font-bold text-emerald-900">51.2V 60AH</h3>
            <span class="text-xs text-neutral-500 font-mono">33-106</span>
          </div>
          <p class="text-sm text-emerald-700 font-semibold mb-3">Fits 48V Golf Carts</p>
          <p class="text-3xl font-bold text-emerald-600 mb-4">24 mi <span class="text-sm font-normal text-neutral-500">range</span></p>
          <p class="text-sm text-neutral-600">Entry-level 48V pack. Lightweight, affordable, ideal for short-distance neighborhood use.</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-lg border-2 border-emerald-300 bg-gradient-to-br from-emerald-50 to-white relative">
          <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-emerald-600 text-white px-4 py-1 rounded-full text-xs font-bold">MOST POPULAR</div>
          <div class="flex items-baseline justify-between mb-3 mt-2">
            <h3 class="text-2xl font-bold text-emerald-900">51.2V 105AH</h3>
            <span class="text-xs text-neutral-500 font-mono">33-110</span>
          </div>
          <p class="text-sm text-emerald-700 font-semibold mb-3">Fits 48V Golf Carts</p>
          <p class="text-3xl font-bold text-emerald-600 mb-4">50 mi <span class="text-sm font-normal text-neutral-500">range</span></p>
          <p class="text-sm text-neutral-600">The sweet spot. The pack we recommend most for The Villages, Del Webb Stonecrest, and Ocala-area daily drivers.</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-lg border border-emerald-100 hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
          <div class="flex items-baseline justify-between mb-3">
            <h3 class="text-2xl font-bold text-emerald-900">51.2V 105AH Thin</h3>
            <span class="text-xs text-neutral-500 font-mono">33-114</span>
          </div>
          <p class="text-sm text-emerald-700 font-semibold mb-3">Fits 48V Golf Carts</p>
          <p class="text-3xl font-bold text-emerald-600 mb-4">50 mi <span class="text-sm font-normal text-neutral-500">range</span></p>
          <p class="text-sm text-neutral-600">Slim profile version for tight battery compartments. Same 50-mile range, easier fit on certain Yamaha and lifted carts.</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-lg border border-emerald-100 hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
          <div class="flex items-baseline justify-between mb-3">
            <h3 class="text-2xl font-bold text-emerald-900">51.2V 160AH</h3>
            <span class="text-xs text-neutral-500 font-mono">33-118</span>
          </div>
          <p class="text-sm text-emerald-700 font-semibold mb-3">Fits 48V Golf Carts</p>
          <p class="text-3xl font-bold text-emerald-600 mb-4">70 mi <span class="text-sm font-normal text-neutral-500">range</span></p>
          <p class="text-sm text-neutral-600">Maximum 48V range. Built for heavy users, lifted 6-passenger carts, and folks who want to charge less often.</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-lg border border-emerald-100 hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
          <div class="flex items-baseline justify-between mb-3">
            <h3 class="text-2xl font-bold text-emerald-900">73.6V 105AH</h3>
            <span class="text-xs text-neutral-500 font-mono">33-122</span>
          </div>
          <p class="text-sm text-emerald-700 font-semibold mb-3">Fits 72V Golf Carts</p>
          <p class="text-3xl font-bold text-emerald-600 mb-4">70 mi <span class="text-sm font-normal text-neutral-500">range</span></p>
          <p class="text-sm text-neutral-600">High-voltage performance for 72V street-legal LSVs and high-output carts. Top speed and top range.</p>
        </div>
      </div>

      <p class="text-center text-sm text-neutral-500 mt-8">All models available with heated or non-heated configurations. Not sure which pack fits your cart? Call us — we'll walk you through it.</p>
    </div>
  </section>

  <!-- Cart Compatibility -->
  <section class="py-16 sm:py-20 bg-gradient-to-br from-emerald-50 to-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-16">
        <span class="inline-block bg-emerald-100 text-emerald-800 px-4 py-2 rounded-full text-sm font-semibold mb-4">Cart Compatibility</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-emerald-900 mb-6">We Convert Every Major Brand</h2>
        <p class="text-lg sm:text-xl text-neutral-600 max-w-2xl mx-auto px-4">Bolt Energy lithium packs are engineered to drop into the brands you already own</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl p-6 text-center shadow-md hover:shadow-lg border border-emerald-100 hover:border-emerald-300 transition-all duration-300">
          <i class="fa-solid fa-bolt text-emerald-600 text-2xl mb-3"></i>
          <h3 class="font-bold text-emerald-900">EZGO</h3>
          <p class="text-xs text-neutral-500 mt-1">RXV, TXT, Express</p>
        </div>
        <div class="bg-white rounded-xl p-6 text-center shadow-md hover:shadow-lg border border-emerald-100 hover:border-emerald-300 transition-all duration-300">
          <i class="fa-solid fa-bolt text-emerald-600 text-2xl mb-3"></i>
          <h3 class="font-bold text-emerald-900">Club Car</h3>
          <p class="text-xs text-neutral-500 mt-1">Precedent, Onward, Tempo</p>
        </div>
        <div class="bg-white rounded-xl p-6 text-center shadow-md hover:shadow-lg border border-emerald-100 hover:border-emerald-300 transition-all duration-300">
          <i class="fa-solid fa-bolt text-emerald-600 text-2xl mb-3"></i>
          <h3 class="font-bold text-emerald-900">Yamaha</h3>
          <p class="text-xs text-neutral-500 mt-1">Drive2, UMAX</p>
        </div>
        <div class="bg-white rounded-xl p-6 text-center shadow-md hover:shadow-lg border border-emerald-100 hover:border-emerald-300 transition-all duration-300">
          <i class="fa-solid fa-bolt text-emerald-600 text-2xl mb-3"></i>
          <h3 class="font-bold text-emerald-900">Evolution</h3>
          <p class="text-xs text-neutral-500 mt-1">Classic, Carrier, Forester</p>
        </div>
        <div class="bg-white rounded-xl p-6 text-center shadow-md hover:shadow-lg border border-emerald-100 hover:border-emerald-300 transition-all duration-300">
          <i class="fa-solid fa-bolt text-emerald-600 text-2xl mb-3"></i>
          <h3 class="font-bold text-emerald-900">Bintelli</h3>
          <p class="text-xs text-neutral-500 mt-1">All models</p>
        </div>
        <div class="bg-white rounded-xl p-6 text-center shadow-md hover:shadow-lg border border-emerald-100 hover:border-emerald-300 transition-all duration-300">
          <i class="fa-solid fa-bolt text-emerald-600 text-2xl mb-3"></i>
          <h3 class="font-bold text-emerald-900">Bad Boy</h3>
          <p class="text-xs text-neutral-500 mt-1">Buggies, Off-Road</p>
        </div>
        <div class="bg-white rounded-xl p-6 text-center shadow-md hover:shadow-lg border border-emerald-100 hover:border-emerald-300 transition-all duration-300">
          <i class="fa-solid fa-bolt text-emerald-600 text-2xl mb-3"></i>
          <h3 class="font-bold text-emerald-900">GEM</h3>
          <p class="text-xs text-neutral-500 mt-1">e2, e4, e6</p>
        </div>
        <div class="bg-white rounded-xl p-6 text-center shadow-md hover:shadow-lg border border-emerald-100 hover:border-emerald-300 transition-all duration-300">
          <i class="fa-solid fa-bolt text-emerald-600 text-2xl mb-3"></i>
          <h3 class="font-bold text-emerald-900">Plus Many More</h3>
          <p class="text-xs text-neutral-500 mt-1">Kandi, Madjax, Epic, Navitas, Trojan EV</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-16">
        <span class="inline-block bg-emerald-100 text-emerald-800 px-4 py-2 rounded-full text-sm font-semibold mb-4">Service Area</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-emerald-900 mb-6">25-Mile Radius Around Belleview, FL</h2>
        <p class="text-lg sm:text-xl text-neutral-600 max-w-2xl mx-auto px-4">Free local installation and pickup throughout central Florida's most active golf cart communities</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mb-12">
        <div class="bg-emerald-50 rounded-xl p-5 text-center border border-emerald-200">
          <i class="fa-solid fa-location-dot text-emerald-600 text-xl mb-2"></i>
          <h3 class="font-bold text-emerald-900">The Villages</h3>
          <p class="text-xs text-neutral-600 mt-1">Florida's largest community</p>
        </div>
        <div class="bg-emerald-50 rounded-xl p-5 text-center border border-emerald-200">
          <i class="fa-solid fa-location-dot text-emerald-600 text-xl mb-2"></i>
          <h3 class="font-bold text-emerald-900">Belleview</h3>
          <p class="text-xs text-neutral-600 mt-1">Our home base</p>
        </div>
        <div class="bg-emerald-50 rounded-xl p-5 text-center border border-emerald-200">
          <i class="fa-solid fa-location-dot text-emerald-600 text-xl mb-2"></i>
          <h3 class="font-bold text-emerald-900">Stonecrest</h3>
          <p class="text-xs text-neutral-600 mt-1">Gated 55+ community</p>
        </div>
        <div class="bg-emerald-50 rounded-xl p-5 text-center border border-emerald-200">
          <i class="fa-solid fa-location-dot text-emerald-600 text-xl mb-2"></i>
          <h3 class="font-bold text-emerald-900">Del Webb Stonecrest</h3>
          <p class="text-xs text-neutral-600 mt-1">Active adult living</p>
        </div>
        <div class="bg-emerald-50 rounded-xl p-5 text-center border border-emerald-200">
          <i class="fa-solid fa-location-dot text-emerald-600 text-xl mb-2"></i>
          <h3 class="font-bold text-emerald-900">Downtown Ocala</h3>
          <p class="text-xs text-neutral-600 mt-1">Historic district</p>
        </div>
        <div class="bg-emerald-50 rounded-xl p-5 text-center border border-emerald-200">
          <i class="fa-solid fa-location-dot text-emerald-600 text-xl mb-2"></i>
          <h3 class="font-bold text-emerald-900">Horse Farms</h3>
          <p class="text-xs text-neutral-600 mt-1">Marion County country</p>
        </div>
        <div class="bg-emerald-50 rounded-xl p-5 text-center border border-emerald-200">
          <i class="fa-solid fa-location-dot text-emerald-600 text-xl mb-2"></i>
          <h3 class="font-bold text-emerald-900">Lake Communities</h3>
          <p class="text-xs text-neutral-600 mt-1">Weirsdale, Summerfield</p>
        </div>
        <div class="bg-emerald-50 rounded-xl p-5 text-center border border-emerald-200">
          <i class="fa-solid fa-location-dot text-emerald-600 text-xl mb-2"></i>
          <h3 class="font-bold text-emerald-900">RV &amp; Campgrounds</h3>
          <p class="text-xs text-neutral-600 mt-1">Snowbird-friendly</p>
        </div>
      </div>

      <div class="text-center">
        <p class="text-neutral-600 mb-4">Not sure if you're in our radius? Give us a call — chances are, we serve your neighborhood.</p>
        <a href="tel:+13527801526" class="bg-gradient-to-r from-emerald-600 to-emerald-700 text-white px-10 py-4 rounded-full text-lg font-semibold hover:from-emerald-700 hover:to-emerald-800 transform hover:scale-105 transition-all duration-300 shadow-lg inline-block">
          <i class="fa-solid fa-phone mr-2"></i> Check My Address
        </a>
      </div>
    </div>
  </section>

  <!-- Promotional Calendar -->
  <section class="py-16 sm:py-20 bg-gradient-to-br from-emerald-50 to-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
