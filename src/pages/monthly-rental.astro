const content = {"eyebrow": "Monthly rentals / Ocala", "heading": "Settle into your stay in Ocala.", "intro": "Request a golf cart for a month or longer in Ocala. Give us your full travel dates so we can discuss availability and a quote for the whole stay.", "image": "/golf cart images/fleet-aerial-2.jpg", "imageAlt": "Golf carts arranged for rental", "sections": [{"title": "Quote the whole stay.", "body": "A calendar month and four weeks are not always the same length. Send the actual start and end dates rather than estimating a number of weeks."}, {"title": "Plan delivery before arrival.", "body": "Share your delivery address or neighborhood. If your vacation address is not available yet, say so when you inquire; the team can explain what is needed to confirm arrangements."}, {"title": "Ask before extending.", "body": "If your plans change, contact the team before the scheduled return date. An extension depends on availability and the additional cost; it is not automatic."}], "links": [{"label": "Compare carts & pricing", "href": "/rentals/"}, {"label": "Weekly rentals", "href": "/weekly-rental/"}, {"label": "Contact the rental team", "href": "/contact/"}], "phone": "(352) 780-1526", "tel": "+13527801526"};
---
